{
  "actorSpecification": 1,
  "name": "meetup-scraper",
  "title": "Meetup Event Scraper — AI Agent Data Feed",
  "description": "Extract events from Meetup.com by location, category, and date.",
  "version": "1.0.0",
  "input": "input_schema.json",
  "storages": {
    "dataset": {
      "actorSpecification": 1,
      "fields": {
        "eventName": {
          "type": "string",
          "title": "Event Name"
        },
        "eventUrl": {
          "type": "string",
          "title": "Event URL"
        }
      },
      "views": {
        "overview": {
          "title": "Overview",
          "transformation": {
            "fields": ["eventName", "eventUrl"]
          }
        }
      }
    }
  },
  "dockerfile": "./Dockerfile"
}
