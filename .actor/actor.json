{
  "actorSpecification": 1,
  "name": "meetup-scraper",
  "title": "Meetup Event Scraper — AI Agent Data Feed",
  "description": "Extract events from Meetup.com by location, category, and date. Get event details, organizer info, attendee counts, and venue data. Works with Claude, ChatGPT, and AI agents via Apify MCP. Perfect for event discovery, community research, and networking intelligence.",
  "version": "0.1",
  "buildTag": "latest",
  "dockerfile": "./Dockerfile",
  "storages": {
    "dataset": {
      "actorSpecification": 1,
      "title": "Meetup Event Results",
      "description": "Scraped event data from Meetup.com",
      "views": {
        "overview": {
          "title": "Overview",
          "transformation": {
            "fields": [
              "eventName",
              "groupName",
              "dateTime",
              "city",
              "attendeeCount",
              "eventUrl"
            ]
          },
          "display": {
            "component": "table",
            "properties": {
              "eventName": {
                "label": "Event Name",
                "format": "text"
              },
              "groupName": {
                "label": "Organizer",
                "format": "text"
              },
              "dateTime": {
                "label": "Date & Time",
                "format": "text"
              },
              "city": {
                "label": "City",
                "format": "text"
              },
              "attendeeCount": {
                "label": "Attendees",
                "format": "number"
              },
              "eventUrl": {
                "label": "Event URL",
                "format": "link"
              }
            }
          }
        }
      },
      "fields": {
        "eventName": {
          "type": "string",
          "title": "Event Name",
          "description": "Title of the meetup event"
        },
        "eventUrl": {
          "type": "string",
          "title": "Event URL",
          "description": "Link to event page on Meetup",
          "format": "url"
        },
        "groupName": {
          "type": "string",
          "title": "Organizer Group",
          "description": "Name of the group organizing the event"
        },
        "groupUrl": {
          "type": "string",
          "title": "Group URL",
          "description": "Link to organizer group page",
          "format": "url"
        },
        "dateTime": {
          "type": "string",
          "title": "Date & Time",
          "description": "When the event takes place",
          "format": "date-time"
        },
        "venue": {
          "type": "string",
          "title": "Venue Name",
          "description": "Name of the event location"
        },
        "address": {
          "type": "string",
          "title": "Address",
          "description": "Full street address of venue"
        },
        "city": {
          "type": "string",
          "title": "City",
          "description": "City where event is held"
        },
        "attendeeCount": {
          "type": "integer",
          "title": "Attendee Count",
          "description": "Number of people attending"
        },
        "description": {
          "type": "string",
          "title": "Description",
          "description": "Full event description"
        },
        "category": {
          "type": "string",
          "title": "Category",
          "description": "Event category or topic"
        },
        "isOnline": {
          "type": "boolean",
          "title": "Is Online",
          "description": "Whether event is virtual"
        },
        "scrapedAt": {
          "type": "string",
          "title": "Scraped At",
          "description": "Extraction timestamp",
          "format": "date-time"
        }
      }
    }
  }
}
